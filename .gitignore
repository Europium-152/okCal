# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

.*
!.gitignore

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# scratch / generated
tmpclaude-*
coverage/
*.zip
error_message_*.txt

# Needed so EAS Build installs with legacy peer deps
!.npmrc
